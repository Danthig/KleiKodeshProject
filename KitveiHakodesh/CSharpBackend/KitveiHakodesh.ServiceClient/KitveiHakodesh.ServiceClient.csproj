<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ONLY way a hosted process (KitveiHakodeshLib, the Word VSTO add-in, KitveiHakodeshDemoApp)
    reaches seforim data: a client for the KitveiHakodeshService named pipe.

    This project knows the pipe, the frame and the {Op, Args} / {Ok, Result, Error} envelope -
    and nothing else. It references no database, no search engine and no MessagePack: the bytes
    it carries are opaque to it. That is the point of the migration this project starts: SQLite,
    Lucene and FtsLib are referenced by KitveiHakodeshService alone; every other project talks to
    the service.

    IKitveiHakodeshServiceChannel is the seam. Today the pipe is its only implementation; an
    in-process fallback, should one ever be wanted, is a second implementation and no caller changes.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>KitveiHakodesh.ServiceClient</RootNamespace>
    <AssemblyName>KitveiHakodesh.ServiceClient</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

</Project>
