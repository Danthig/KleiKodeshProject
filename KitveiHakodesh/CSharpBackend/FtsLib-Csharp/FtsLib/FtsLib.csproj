<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ONE engine, two legs. There used to be a second project, FtsLib.Net48, holding a
      byte-for-byte revert of this library on System.Data.SQLite — so every fix had to be made
      twice, and the two copies had already drifted. Both legs build from THIS source now.

        net48      — the Word VSTO add-in and anything else .NET Framework reaches Core from.
        net10.0    — the dev service.

      The net10-only fast paths are kept and guarded with #if, not dropped: a preprocessor
      branch costs nothing at runtime, because only the taken branch is compiled into each
      leg's assembly. Today that is TrigramIndex alone (RandomAccess / File.OpenHandle are
      net6+); everything else here compiles unchanged on both.
    -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <!-- One source tree, two legs: do not let net48 fall back to its C# 7.3 default. -->
    <LangVersion>latest</LangVersion>
    <RootNamespace>FtsLib</RootNamespace>
    <AssemblyName>FtsLib</AssemblyName>
    <!-- Keep the hand-written Properties\AssemblyInfo.cs (holds InternalsVisibleTo("FtsLibTest")). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- CA1416: Microsoft.VisualBasic.Interaction.GetSetting is Windows-only; fine (runs on Windows). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- For SIMD hot-path optimizations (Vector256/512 loads, hardware popcount). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Microsoft.VisualBasic is part of the shared framework on the modern leg but is an
       assembly reference on .NET Framework. ZayitDb reads the Zayit app's saved library path
       through Interaction.GetSetting, which is where that setting lives. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to 10.0.9 to match KitveiHakodeshService (avoids a diamond version conflict). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Seforim databases from SeforimLibrary schema 6 on store line content zstd-compressed
         with a dictionary shipped inside the database. Pure-C# port: nothing native to
         package, and it resolves on both this leg and the net48 twin. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

  <!-- The related-forms expansion artifact (research/word-association, FINDINGS
       26/27). ONE canonical copy shared by every FtsLib flavour lives in
       FtsLib-Csharp/SearchExpansion/ - updating that file updates all outputs.
       Copied next to consumers as SearchExpansion/expansion-routed.db and read
       at runtime relative to the binary (see SearchExpansionService /
       SearchExpansion). -->
  <ItemGroup>
    <Content Include="..\SearchExpansion\expansion-routed.db">
      <Link>SearchExpansion\expansion-routed.db</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
